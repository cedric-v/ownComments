rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /comments/{pageId}/messages/{messageId} {
      // Lecture publique (widget de commentaires)
      allow read: if true;

      function validComment() {
        return request.resource.data.keys().hasOnly(['name', 'text', 'timestamp'])
          // Types et longueurs
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.timestamp is timestamp
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          // Le timestamp doit être le timestamp serveur (serverTimestamp())
          && request.resource.data.timestamp == request.time
          // Bloquer les caractères HTML potentiellement dangereux
          && !request.resource.data.name.matches('.*[<>].*')
          && !request.resource.data.text.matches('.*[<>].*');
      }

      // Création seule : pas d'update/delete par le public
      allow create: if validComment();
      allow update, delete: if false;
    }
  }
}
